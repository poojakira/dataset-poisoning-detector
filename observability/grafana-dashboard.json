{
  "id": null,
  "uid": "poison-detector-overview",
  "title": "Poison Detector - Overview",
  "description": "Real-time monitoring dashboard for the dataset poisoning detection system",
  "tags": ["poison-detector", "ml-security", "observability"],
  "timezone": "utc",
  "refresh": "10s",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "hide": 0,
        "label": "Data Source"
      },
      {
        "name": "environment",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(poison_detector_samples_processed_total, environment)",
        "current": {
          "text": "prod",
          "value": "prod"
        },
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "hide": 0,
        "label": "Environment",
        "refresh": 2
      },
      {
        "name": "interval",
        "type": "interval",
        "query": "1m,5m,10m,30m,1h",
        "current": {
          "text": "5m",
          "value": "5m"
        },
        "hide": 0,
        "label": "Interval"
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": "${datasource}",
        "enable": true,
        "expr": "ALERTS{alertname=~\"PoisonRateHigh|LatencyDegraded|DriftSpike|DetectorDown|QueueBacklog|HighErrorRate|RefitLatencyHigh\", alertstate=\"firing\"}",
        "iconColor": "red",
        "name": "Alert Events",
        "titleFormat": "{{ alertname }}",
        "textFormat": "{{ description }}"
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Overview",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Scoring Throughput (samples/sec)",
      "description": "Rate of samples processed per second",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 1},
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisLabel": "samples/sec",
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "expr": "rate(poison_detector_samples_processed_total{environment=~\"$environment\"}[$interval])",
          "legendFormat": "throughput - {{environment}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Current Poison Rate",
      "description": "Rolling fraction of samples flagged as poisoned",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 1},
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.05},
              {"color": "red", "value": 0.1}
            ]
          },
          "min": 0,
          "max": 1,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "poison_detector_poison_rate{environment=~\"$environment\"}",
          "legendFormat": "{{environment}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Uptime",
      "description": "Detector target availability",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 1},
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.95},
              {"color": "green", "value": 0.99}
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["mean"],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "avg_over_time(up{job=\"poison-detector\"}[1h])",
          "legendFormat": "uptime",
          "refId": "A"
        }
      ]
    },
    {
      "id": 200,
      "type": "row",
      "title": "Latency",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Scoring Latency Percentiles",
      "description": "p50, p95, p99 scoring latency over time",
      "gridPos": {"h": 8, "w": 16, "x": 0, "y": 10},
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisLabel": "latency",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(poison_detector_scoring_latency_seconds_bucket{environment=~\"$environment\"}[$interval]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(poison_detector_scoring_latency_seconds_bucket{environment=~\"$environment\"}[$interval]))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(poison_detector_scoring_latency_seconds_bucket{environment=~\"$environment\"}[$interval]))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Batch Latency",
      "description": "Batch processing latency percentiles",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 10},
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisLabel": "latency",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(poison_detector_batch_latency_seconds_bucket{environment=~\"$environment\"}[$interval]))",
          "legendFormat": "p95 batch",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, rate(poison_detector_batch_latency_seconds_bucket{environment=~\"$environment\"}[$interval]))",
          "legendFormat": "p99 batch",
          "refId": "B"
        }
      ]
    },
    {
      "id": 300,
      "type": "row",
      "title": "Detection",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 18},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Poison Rate Over Time",
      "description": "Ratio of poisoned to total samples processed",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 19},
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisLabel": "rate",
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 0.1}
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "expr": "rate(poison_detector_samples_poisoned_total{environment=~\"$environment\"}[$interval]) / rate(poison_detector_samples_processed_total{environment=~\"$environment\"}[$interval])",
          "legendFormat": "poison rate - {{environment}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Drift Score",
      "description": "Current concept drift detection score",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 19},
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisLabel": "score",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.5},
              {"color": "red", "value": 0.8}
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "expr": "poison_detector_drift_score{environment=~\"$environment\"}",
          "legendFormat": "drift score - {{environment}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Duplicates Detected",
      "description": "Rate of duplicate/near-duplicate samples detected",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 19},
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisLabel": "duplicates/sec",
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "expr": "rate(poison_detector_duplicates_detected_total{environment=~\"$environment\"}[$interval])",
          "legendFormat": "duplicates/sec - {{environment}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 400,
      "type": "row",
      "title": "Resources",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 27},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Queue Depth",
      "description": "Number of samples waiting in the processing queue",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 28},
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisLabel": "samples",
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 500},
              {"color": "red", "value": 1000}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "expr": "poison_detector_queue_depth{environment=~\"$environment\"}",
          "legendFormat": "queue depth - {{environment}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Baseline Size",
      "description": "Number of samples in the current IsolationForest baseline",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 28},
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "blue", "value": null}
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "poison_detector_baseline_size{environment=~\"$environment\"}",
          "legendFormat": "baseline size",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Fingerprint Store Size",
      "description": "Number of fingerprints in the bloom filter store",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 28},
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "purple", "value": null}
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "poison_detector_fingerprint_store_size{environment=~\"$environment\"}",
          "legendFormat": "fingerprint store",
          "refId": "A"
        }
      ]
    },
    {
      "id": 500,
      "type": "row",
      "title": "Alerts",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 36},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Alert Events",
      "description": "Timeline of alert state changes",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 37},
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisLabel": "alerts",
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "expr": "rate(poison_detector_alerts_sent_total{environment=~\"$environment\"}[$interval])",
          "legendFormat": "alerts - {{channel}}",
          "refId": "A"
        }
      ]
    }
  ]
}
