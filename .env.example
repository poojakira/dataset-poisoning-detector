# Safe local environment template
#
# Copy this file to ".env" and provide your own values. Never commit the
# populated .env file. These are examples/placeholders, not credentials.

# Required for protected FastAPI endpoints. Use your own strong random value.
API_KEY=replace-with-your-own-32-plus-character-random-value

# Required by the local Grafana container.
GRAFANA_ADMIN_PASSWORD=replace-with-your-own-local-admin-password

# Optional runtime settings.
POISON_ENVIRONMENT=local-demo
POISON_REDIS_URL=redis://redis:6379/0
POISON_RATE_LIMIT_RPM=100

# Optional: path inside the API container to a trusted NPZ baseline artifact.
# The NPZ must contain a numeric 2D array named "features".
# POISON_BASELINE_PATH=/app/path/to/baseline.npz

# Generic AlertDispatcher WebhookChannel destinations are disabled by default.
# Set exact comma-separated public DNS hosts approved by your operator.
# HTTPS port 443 only; private/internal network endpoints are rejected even
# when their names are listed. Leave empty unless using custom webhooks.
POISON_ALERT_WEBHOOK_HOSTS=
